<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:AppTasks.Controls"
             xmlns:views="clr-namespace:AppTasks.Views"
             x:Name="this"
             x:Class="AppTasks.Views.AppMain">

    <VerticalStackLayout x:Name="LAppMainMaster" Spacing="5">
        
        <views:MenuView x:Name="userMenu"
                        />
        
        <ScrollView x:Name="LAppMainScroll">
            <VerticalStackLayout x:Name="LAppMainDetail" Spacing="5">
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppConfirmation x:Name="Actions"/>

    </VerticalStackLayout>
    
</ContentView>
