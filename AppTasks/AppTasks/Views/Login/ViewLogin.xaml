<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppTasks.Views.Login"
             x:Name="this"
             x:Class="AppTasks.Views.Login.ViewLogin"
             x:DataType="local:ViewLogin" >

    <VerticalStackLayout x:Name="layerLogin" Padding="70, 0, 40, 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
                <Entry Grid.Row="0" Grid.ColumnSpan="4" 
                    x:Name="txtUser"
                    Placeholder = "Enter username"
                    FontSize = "18"
                    WidthRequest = "240"
                    HorizontalOptions = "Center"
                    VerticalOptions = "Center" />
                <Entry Grid.Row="1" Grid.ColumnSpan="4"
                    x:Name = "txtPass"
                    Placeholder = "Enter password"
                    FontSize = "18"
                    WidthRequest = "240"
                    HorizontalOptions = "Center"
                    VerticalOptions = "Center" />
                <Button Grid.Row="3" Grid.Column="1"
                    StyleId = "btnBack"
                    Text = "Back"
                    FontSize = "14"
                    SemanticProperties.Hint = "Back to main menu."
                    WidthRequest = "90"
                    HorizontalOptions = "Center"
                    VerticalOptions = "Center" />
                <Button Grid.Row="3" Grid.Column="3"
                    StyleId = "btnSigIn"
                    Text = "Sign up"
                    FontSize = "14"
                    SemanticProperties.Hint = "Log In into the application."
                    WidthRequest = "90"
                    HorizontalOptions = "Center"
                    VerticalOptions = "Center" />

        </Grid>
    </VerticalStackLayout>
</ContentView>
