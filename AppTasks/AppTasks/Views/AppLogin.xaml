<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTasks.Views.AppLogin"
             HeightRequest="180">
    <VerticalStackLayout x:Name="llogin">
        <Grid x:Name="layerLogin" HeightRequest="180">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="0.4*"/>
            </Grid.ColumnDefinitions>
            <Entry Grid.ColumnSpan="2" Grid.Row="0" 
                   x:Name="txtUser" Placeholder="Enter username" />
            <Entry Grid.ColumnSpan="2" Grid.Row="1"
                   x:Name="txtPass" Placeholder="Enter password" IsPassword="True" />
            <HorizontalStackLayout Grid.ColumnSpan="2" Grid.Row="3" 
                                   Spacing="10" 
                                   HeightRequest="40" 
                                   HorizontalOptions="Center">
                <Button x:Name="btnBack" Text="Back" 
                    BackgroundColor="DarkGreen"
                    SemanticProperties.Hint="Back to main window." />
                <Button x:Name="btnSigIn" Text="Sign up" 
                    BackgroundColor="Green"
                    SemanticProperties.Hint="Log In into the application." />
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentView>
