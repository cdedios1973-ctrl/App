<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTasks.Resources.AppConfirmation"
             x:Name="AppYesNo"
             HeightRequest="40">
    <VerticalStackLayout x:Name="layerConfirmation">
        <HorizontalStackLayout x:Name="btnConfirmation" Padding="10,0" Spacing="20" HeightRequest="40" HorizontalOptions="Center">
            <Label Text="Are you sure to continue ?" VerticalTextAlignment="Center" />
            <Button x:Name="btnYes"
                Text="Accept"
                SemanticProperties.Hint="Accept"
                HorizontalOptions="Center"
                Background="DarkGreen"
                WidthRequest="70" />
            <Button x:Name="btnNo"
                Text="Cancel" 
                SemanticProperties.Hint="Cancel"
                HorizontalOptions="Center"
                Background="DarkGreen"
                WidthRequest="70" />
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentView>
