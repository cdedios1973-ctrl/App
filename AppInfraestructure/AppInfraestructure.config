<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!--
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
     -->
    <!-- Connection string definitions -->
    <connectionStrings>
		<clear />
        <add name="SqlServerConnection"
                connectionString="Server=(localdb)\MSSQLLocalDB;Database=MiBaseDeDatosLocal;Trusted_Connection=True;" 
                providerName="System.Data.SqlClient" />
	    <add name="SqliteConnection"
                connectionString="Data Source=miBaseDatos.db;Version=3;" 
                providerName="System.Data.SQLite" />
    </connectionStrings>

</configuration>