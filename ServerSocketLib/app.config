<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="ConnectionDriver" value="DbLib.Connections.MySql"/>
  </appSettings>
  <connectionStrings>
      <add name="MySql" connectionString="server=localhost;User Id=root;Persist Security Info=True;database=tpv_server" providerName="MySql.Data.MySqlClient"/>
  </connectionStrings>
<startup><supportedRuntime version="v2.0.50727"/></startup></configuration>
