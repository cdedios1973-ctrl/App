<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AppTasks.Views.Menu"
             x:Name="this"
             x:Class="AppTasks.Views.Menu.ViewMenu"
             x:DataType="local:ViewMenu" >

    <HorizontalStackLayout x:Name = "LViewMenu"
		    Spacing = "3"
		    HeightRequest = "40"
		    VerticalOptions = "Center" >
        <Button x:Name="btnInstall"
                Text = "Install"
                Background="OliveDrab"
                HorizontalOptions = "End"
                VerticalOptions = "Center" />
        <Button x:Name="btnSource"
                Text = "Source"
                Background="OliveDrab"
                HorizontalOptions = "End"
                VerticalOptions = "Center" />
        <Button x:Name="btnUsers"
                Text = "Users"
                Background="OliveDrab"
                HorizontalOptions = "End"
                VerticalOptions = "Center" />
        <Button x:Name="btnLogin"
                Text = "{Binding UserLogged, FallbackValue='Login'}"
                Background="OliveDrab"
                HorizontalOptions = "End"
                VerticalOptions = "Center" />
    </HorizontalStackLayout>
    
</ContentView>
